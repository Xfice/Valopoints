# PostgreSQL (Neon free tier for local + Vercel deploy):
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Local SQLite is not used when deploying to Vercel.
REDIS_URL="redis://localhost:6379"
HENRIK_API_KEY=your-henrik-api-key
SESSION_SECRET=your-session-secret-min-32-characters
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@valopoints.local
ADMIN_PASSWORD=Admin123!

# Email (for forgot password) - use SMTP or Resend
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@valopoints.local
